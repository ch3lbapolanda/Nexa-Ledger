generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum JournalLineSide {
  DEBIT
  CREDIT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  COMPLETED
  REVERSED
}

model User {
  id       String     @id @default(uuid()) @db.Uuid
  email    String     @unique @db.VarChar(255)
  fullName String     @db.VarChar(120)
  role     UserRole   @default(CUSTOMER)
  status   UserStatus @default(PENDING_VERIFICATION)

  wallet      Wallet?
  credentials UserCredential[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("users")
}

model UserCredential {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String       @db.VarChar(255)
  passwordHash   String?      @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_credentials")
}

model Wallet {
  id       String       @id @default(uuid()) @db.Uuid
  userId   String       @unique @db.Uuid
  currency String       @default("IDR") @db.Char(3)
  status   WalletStatus @default(ACTIVE)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  account Account?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("wallets")
}

model Account {
  id            String               @id @default(uuid()) @db.Uuid
  walletId      String?              @unique @db.Uuid
  code          String               @unique @db.VarChar(50)
  name          String               @db.VarChar(120)
  type          AccountType
  normalBalance AccountNormalBalance
  balance       BigInt               @default(0)
  status        AccountStatus        @default(ACTIVE)

  wallet       Wallet?       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  journalLines JournalLine[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([type, status])
  @@map("accounts")
}

model JournalEntry {
  id          String             @id @default(uuid()) @db.Uuid
  reference   String?            @unique @db.VarChar(100)
  description String             @db.VarChar(255)
  status      JournalEntryStatus @default(DRAFT)
  postedAt    DateTime?          @db.Timestamptz(3)

  lines       JournalLine[]
  transaction Transaction?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([postedAt])
  @@map("journal_entries")
}

model JournalLine {
  id             String          @id @default(uuid()) @db.Uuid
  journalEntryId String          @db.Uuid
  accountId      String          @db.Uuid
  side           JournalLineSide
  amount         BigInt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([journalEntryId])
  @@index([accountId, createdAt])
  @@map("journal_lines")
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  reference   String            @unique @db.VarChar(100)
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  amount      BigInt
  currency    String            @default("IDR") @db.Char(3)
  description String            @db.VarChar(255)

  journalEntryId String       @unique @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  completedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([type, status, createdAt])
  @@index([createdAt])
  @@map("financial_transactions")
}
